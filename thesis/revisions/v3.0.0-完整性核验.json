  "edits": [
    {
      "id": "M01",
      "pid": 61,
      "location": "第1章 1.2.1",
      "reason": "仅收敛开头、理论贡献及结尾的度量创新宣称；中间对Z-score和RWA/TA的原有解释及研究结果不变。",
      "original_sha256": "246210fcada5d27431bd71d297495f5e5a69e10b11de306c6d67f162d41c2a56",
      "original_chars": 431,
      "revised_chars": 403
    },
    {
      "id": "M02",
      "pid": 85,
      "location": "第1章 1.3.2",
      "reason": "只改研究方法对“确保可靠”“已识别机制”和“全面证据”的概括，保留已有面板、机器学习和敏感性方法的叙述，不增加分析。",
      "original_sha256": "f375add8c728e130e362d313deae7f0025f04097fcbaea6a75be031ecb92eb87",
      "original_chars": 168,
      "revised_chars": 153
    },
    {
      "id": "M03",
      "pid": 89,
      "location": "第1章 1.4",
      "reason": "仅将创新总论和“分离效应、捕捉路径”改为同一框架下考察指标；原段末尾实证结果及政策意义原句保留。",
      "original_sha256": "0a1ccf434073fe58acfe645a76d32e172806110c009f3ee94676f06d4d3a8d5c",
      "original_chars": 211,
      "revised_chars": 212
    },
    {
      "id": "M04",
      "pid": 90,
      "location": "第1章 1.4",
      "reason": "只改首句贡献定位，其余原段全部保留，避免把并置既有指标直接认作方法创新。",
      "original_sha256": "066c1ab37ce86c30f93169d00f0c361885638f54da0f71cd4f4b00d82a063728",
      "original_chars": 207,
      "revised_chars": 207
    },
    {
      "id": "M05",
      "pid": 91,
      "location": "第1章 1.4",
      "reason": "撤回Z-score本身构成度量创新的表述，并收敛无系统证据的“多数研究依赖”；指标选择、含义及局限的其余原句完整保留。",
      "original_sha256": "0fe8e3cbb45a219e86bc6ddd823e3b0ffc948b649a811adfd72309b0c8968fc1",
      "original_chars": 200,
      "revised_chars": 202
    },
    {
      "id": "M06",
      "pid": 92,
      "location": "第1章 1.4",
      "reason": "将“揭示机制”改为“考察关系”，修正嵌套的“对……对……”语病；所有原研究发现及交互项结论保持不变。",
      "original_sha256": "0e401f79617dc337bdac79e1da9c91e6106a6d4c349cb44a0ad478f3fb2ccf2f",
      "original_chars": 185,
      "revised_chars": 183
    },
    {
      "id": "M07",
      "pid": 93,
      "location": "第1章 1.4",
      "reason": "将常规分组定位为扩展分析，并把未直接测量的资源禀赋、治理机制改为讨论线索；分组结果、预测方法与趋势原句不变。",
      "original_sha256": "abb1549d9c9d7cd7f63ae15373240e9b9109b022f8ec4c3ddd4d6ae694dc89aa",
      "original_chars": 213,
      "revised_chars": 218
    },
    {
      "id": "M08",
      "pid": 94,
      "location": "第1章 1.4",
      "reason": "局部修正工具变量与预测解释边界，删除指向未实施中介检验框架的失效交叉引用；其余贡献描述及实证结论原句保留。",
      "original_sha256": "9aa92cb539fd9bd53078e8a96d7d7ca966d7d528f00931fc14b2a2d35a57893a",
      "original_chars": 528,
      "revised_chars": 513
    },
    {
      "id": "M09",
      "pid": 104,
      "location": "第2章 2.1",
      "reason": "仅将金融科技被完整分解的强概念关系改为研究观察视角；保留原有微观、宏观两维度及全部定义。",
      "original_sha256": "53cce89c7f9011e6d875c4ce01e0ef1a084f05ea1d991f72ea17760043bbfdce",
      "original_chars": 451,
      "revised_chars": 447
    },
    {
      "id": "M10",
      "pid": 105,
      "location": "第2章 2.1",
      "reason": "将层次结构改为分析视角，将被分解改为从两个相关维度考察；保留原直接效应与调节效应的研究安排。",
      "original_sha256": "09800b6e26a5998c1df05b0d36295791338c8370a578501b7d5d7539041821b0",
      "original_chars": 193,
      "revised_chars": 197
    },
    {
      "id": "M11",
      "pid": 123,
      "location": "第2章 2.3.2",
      "reason": "仅将“外生的”改为“可能的”，不把理论竞争解释当作已识别外生冲击；其他原句保留。",
      "original_sha256": "2c360edb517bd53aec3313dbc5ff576e35fa644d6d8b84fc233ec38fa15dc71b",
      "original_chars": 424,
      "revised_chars": 424
    },
    {
      "id": "M12",
      "pid": 126,
      "location": "第2章 2.3.2",
      "reason": "仅修正Z-score更不易受计提政策影响的无充分依据比较表述；保留原文会计文献及选择Z-score的分析脉络。",
      "original_sha256": "ba33dda66a2486728d48ff3d30a975860fe00d44fbd4a8c5eaa52e786dae3965",
      "original_chars": 410,
      "revised_chars": 405
    },
    {
      "id": "M13",
      "pid": 138,
      "location": "第2章 2.3.4",
      "reason": "仅删除“金融科技的对”中的赘字“的”，修复语病，其余全文不动。",
      "original_sha256": "9bfab3f9cd6a4344cad7feb74604576c93a9b4a21eecc31e7351cf788fedc8ef",
      "original_chars": 252,
      "revised_chars": 251
    },
    {
      "id": "M14",
      "pid": 147,
      "location": "第2章 2.4",
      "reason": "仅替换其二中Z-score前瞻性和国内应用薄弱的判断，明确原文已有盈利、资本及波动口径；其一、其三、其四完整保留。",
      "original_sha256": "3c9c48457d86c77b50862be4558eb5fdd95521d686a7d2debdb94a26863d569d",
      "original_chars": 496,
      "revised_chars": 494
    },
    {
      "id": "M15",
      "pid": 149,
      "location": "第2章 2.4",
      "reason": "仅收敛既有指标应用的前瞻性及创新宣称，将“控制内生性”改为“缓解潜在内生性”；保留原三个贡献框架和研究设计。",
      "original_sha256": "2fe412b403534040bcc9083b167725246894beb454ef9ec441a00c55597026f8",
      "original_chars": 227,
      "revised_chars": 216
    },
    {
      "id": "M16",
      "pid": 171,
      "location": "第3章 3.1.4",
      "reason": "仅撤除金融科技天然外生的未经识别属性，不改竞争稳定理论、U型文献命题或本文实证结论。",
      "original_sha256": "51073e670dd1fa85b44f231501f2b591ff37df8b3e0654f2d9605c08e5b777e1",
      "original_chars": 429,
      "revised_chars": 424
    },
    {
      "id": "M17",
      "pid": 184,
      "location": "第3章 3.2.2",
      "reason": "仅将非线性和分组检验已识别竞争机制的说法改为考察函数形式与分组差异，不改变原理论方向及既有检验安排。",
      "original_sha256": "8adb7dea94a7e201f34beed760c177806522ab29a55d0002d909d37686913fbb",
      "original_chars": 306,
      "revised_chars": 316
    }
  ],
